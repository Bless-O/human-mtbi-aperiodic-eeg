        "## 4. ICA Artifact Auditing (ICLabel) & $1/f$ Slope Sensitivity\n",
        "Load `sub-001` (`ses-01`, `task-DPX`), assign missing BIDS channel types and the `colin27_1020` montage, and run standard scalp preprocessing (1–100 Hz bandpass + average reference). Fit Extended Infomax ICA, auto-exclude ocular, EMG, and channel-noise components via `ICLabel` ($p > 0.65$), and compare pre- vs. post-ICA Welch PSDs and `specparam` $1/f$ exponents at `Fz`."
      ],
      "metadata": {
        "id": "rOHSW0zZ-cd2"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# 1. Load sub-001 (mTBI, ses-01) via MNE-BIDS\n",
        "bids_path = BIDSPath(\n",
        "    root='/content/mtbi_data',\n",
        "    subject='001',\n",
        "    session='01',\n",
        "    task='DPX',\n",
        "    datatype='eeg'\n",
        ")\n",
        "raw = read_raw_bids(bids_path, verbose=False)\n",
        "raw.load_data()\n",
        "\n",
        "# 2. Fix BIDS \"n/a\" channel types and attach standard 10-20 montage\n",
        "ch_types = {}\n",
        "for ch in raw.ch_names:\n",
        "    if 'EOG' in ch.upper():\n",
        "        ch_types[ch] = 'eog'\n",
        "    elif 'EKG' in ch.upper() or 'ECG' in ch.upper():\n",
        "        ch_types[ch] = 'ecg'\n",
        "    else:\n",
        "        ch_types[ch] = 'eeg'\n",
        "\n",
        "raw.set_channel_types(ch_types)\n",
        "raw.set_montage('colin27_1020', on_missing='ignore')\n",
        "\n",
        "# Keep only EEG channels for ICA + spectral analysis\n",
        "raw_eeg = raw.copy().pick('eeg')\n",
        "\n",
        "# 3. Standard human scalp preprocessing (ICLabel expects 1-100 Hz & average ref)\n",
        "raw_filt = raw_eeg.copy().filter(l_freq=1.0, h_freq=100.0, verbose=False)\n",
        "raw_filt.set_eeg_reference('average', projection=False, verbose=False)\n",
        "\n",
        "# 4. Fit ICA\n",
        "ica = mne.preprocessing.ICA(\n",
        "    n_components=15,\n",
