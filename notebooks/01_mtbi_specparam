        "fm_raw = SpectralModel(aperiodic_mode='fixed', peak_width_limits=[1, 12], max_n_peaks=6)\n",
        "fm_cln = SpectralModel(aperiodic_mode='fixed', peak_width_limits=[1, 12], max_n_peaks=6)\n",
        "fm_raw.fit(freqs, p_raw, [2, 40])\n",
        "fm_cln.fit(freqs, p_cln, [2, 40])\n",
