        "target_ch = 'Fz' if 'Fz' in raw_filt.ch_names else raw_filt.ch_names[0]\n",
        "psd_raw = raw_filt.compute_psd(method='welch', fmin=2, fmax=40, n_fft=1024, picks=[target_ch])\n",
